{
  "name": "zowl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx scripts/run-playwright.ts",
    "test:e2e:ui": "tsx scripts/run-playwright.ts --ui",
    "test:mobile": "npm run test:mobile:quick",
    "test:mobile:quick": "cd mobile && flutter analyze && flutter test --coverage --branch-coverage && dart run tool/check_coverage.dart",
    "test:mobile:coverage": "cd mobile && flutter test --coverage --branch-coverage && dart run tool/check_coverage.dart",
    "test:mobile:contract": "npm run test:e2e -- tests/e2e/mobile-api.spec.ts",
    "test:mobile:e2e": "tsx scripts/run-mobile-e2e.ts all",
    "test:mobile:e2e:android": "tsx scripts/run-mobile-e2e.ts android",
    "test:mobile:e2e:ios": "tsx scripts/run-mobile-e2e.ts ios",
    "test:mobile:all": "npm run test:mobile:quick && npm run test:mobile:contract && npm run test:mobile:e2e",
    "mobile:release": "tsx scripts/build-android-release.ts",
    "deploy:production": "tsx scripts/deploy-production.ts",
    "e2e:prepare": "tsx scripts/prepare-e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slot": "^1.3.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "postcss": "^8.5.18",
    "sharp": "^0.35.5"
  }
}
