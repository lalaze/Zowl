DATABASE_URL=.data/zowl.sqlite
FILE_STORAGE_ROOT=storage
PUBLIC_BASE_URL=https://zowl.example-tailnet.ts.net
ANDROID_RELEASE_ROOT=
# Comma-separated extra hosts allowed to use the dev server, e.g. your machine's Tailscale IP.
# DEV_ALLOWED_ORIGINS=100.64.0.10
DEMO_EMAIL=demo@zowl.local
DEMO_PASSWORD=zowl-demo
# Production initialization example:
# INITIAL_ADMIN_SETUP_TOKEN_FILE=/run/zemoney-secrets/initial-admin-setup-token
SESSION_TTL_DAYS=30
RECEIPT_RECOGNITION_PROVIDER=mock
# HTTP Provider sends original screenshots, with explicit user consent, to this HTTPS endpoint.
# RECEIPT_RECOGNITION_HTTP_ENDPOINT=https://recognition.example.com/v1/receipts
# RECEIPT_RECOGNITION_HTTP_API_KEY=replace-me
# RECEIPT_RECOGNITION_HTTP_TIMEOUT_MS=20000

# AI categorization is disabled by default; supports OpenAI official APIs, local models, and compatible services.
AI_CATEGORIZATION_PROVIDER=off
# AI_CATEGORIZATION_BASE_URL=https://api.openai.com/v1
# AI_CATEGORIZATION_MODEL=replace-with-deployed-model
# AI_CATEGORIZATION_API_KEY=replace-me
AI_CATEGORIZATION_RESPONSE_MODE=json_schema
AI_CATEGORIZATION_AUTO_THRESHOLD=0.85
AI_CATEGORIZATION_BATCH_SIZE=20
AI_CATEGORIZATION_TIMEOUT_MS=30000
AI_CATEGORIZATION_ALLOW_INSECURE_HTTP=false
# Required to persist API keys: a Base64-encoded 32-byte master key (`openssl rand -base64 32`).
# AI_CATEGORIZATION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
