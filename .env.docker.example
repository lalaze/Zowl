# The HTTPS URL users open. Production refuses to start without https://.
PUBLIC_BASE_URL=https://money.example.com
# Host name for the Traefik router rule; normally the host part of PUBLIC_BASE_URL.
ZOWL_HOST=money.example.com
ZOWL_PORT=3000
ZOWL_DATA_DIR=./runtime/data
ZOWL_STORAGE_DIR=./runtime/storage
ANDROID_RELEASE_DIR=./runtime/releases/android
ZOWL_SECRETS_DIR=./secrets
SESSION_TTL_DAYS=30
RECEIPT_RECOGNITION_PROVIDER=mock
AI_CATEGORIZATION_PROVIDER=off
# Base64 of 32 random bytes (openssl rand -base64 32). Needed to save an AI provider
# API key on the settings page; keep it with your backups, a lost key loses the saved keys.
# AI_CATEGORIZATION_ENCRYPTION_KEY=
